# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template has no secrets in it and is meant to be committed.
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# typescript incremental build cache
*.tsbuildinfo

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# M2 training data: contains transcript excerpts from the local machine
train/dataset/*.jsonl
# Derived from the above, so it carries the same transcript excerpts verbatim.
# /outputs/ above is root-anchored and does not cover these.
train/mlx_data/
train/outputs/

# Database dumps taken before migrations; contain personal preference text
backups/

# Local archive/reactivation bookkeeping — not portfolio content
REACTIVATED.md
