# Copy to .env. Read by pydantic-settings when running on the host
# (.venv/bin/python -m ...). Containers get their own values from
# docker-compose.yml, so this file is not copied into the image.

# --- infrastructure (host-side; compose publishes db on 5433) ---------------
MINDBRIDGE_DATABASE_URL=postgresql://mindbridge:mindbridge@localhost:5433/mindbridge
MINDBRIDGE_REDIS_URL=redis://localhost:6379/0

# --- embeddings -------------------------------------------------------------
# ollama is the only provider under which write-time dedup actually works: the
# hashing fallback scores real duplicates 0.13-0.73, so no threshold separates
# them from unrelated facts. Requires `ollama serve` and
# `ollama pull nomic-embed-text`.
#
# These three move together. The dim must match the model's output width and the
# vector(...) column, or startup fails the width check — loudly, by design.
MINDBRIDGE_EMBEDDING_PROVIDER=ollama
MINDBRIDGE_EMBEDDING_MODEL=nomic-embed-text
MINDBRIDGE_EMBEDDING_DIM=768

# Model-specific. 0.80 was read off 170 real rows under nomic-embed-text.
# Retune when changing the embedding model; see AGENTS.md.
MINDBRIDGE_DEDUP_THRESHOLD=0.80

# --- M2 extraction ----------------------------------------------------------
# Not needed for the claude-cli provider, which uses Claude Code's own sign-in.
# MINDBRIDGE_OPENAI_API_KEY=
# MINDBRIDGE_GEMINI_API_KEY=

# --- developer-preview signups ---------------------------------------------
# Any endpoint accepting a JSON POST. Unset, /api/waitlist returns 503 and the
# form falls back to a pre-filled mailto: draft.
# WAITLIST_WEBHOOK_URL=
