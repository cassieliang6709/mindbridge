# Copy to .env. Every key is optional; the defaults below are what the code uses.

# --- stores ---------------------------------------------------------------
# Host port 5433 by default, because 5432 is usually already in use.
MINDBRIDGE_DATABASE_URL=postgresql://mindbridge:mindbridge@localhost:5433/mindbridge
MINDBRIDGE_REDIS_URL=redis://localhost:6379/0

# Host publishing for docker compose.
MINDBRIDGE_DB_PORT=5433
MINDBRIDGE_REDIS_PORT=6379
MINDBRIDGE_API_PORT=8000

# --- embeddings -----------------------------------------------------------
# hashing = offline, deterministic, LEXICAL ONLY. Fine for exercising dedup and
# decay; not a semantic model. Never publish a retrieval-quality number measured
# under it. Switch to openai or gemini for real results.
MINDBRIDGE_EMBEDDING_PROVIDER=hashing
MINDBRIDGE_EMBEDDING_DIM=1536
MINDBRIDGE_EMBEDDING_MODEL=text-embedding-3-small
# MINDBRIDGE_OPENAI_API_KEY=sk-...
# gemini text-embedding-004 is 768-wide; changing the dim needs the
# memory_vectors table recreated.
# MINDBRIDGE_GEMINI_API_KEY=...

# --- memory behaviour -----------------------------------------------------
MINDBRIDGE_SESSION_BUFFER_WINDOW=12
# λ in score = cosine * exp(-λ * days). 0.01 ≈ 70% of score left after a month.
MINDBRIDGE_DECAY_RATE_PER_DAY=0.01
MINDBRIDGE_DEDUP_THRESHOLD=0.92
MINDBRIDGE_SUPERSEDED_PENALTY=0.25

# --- cache ----------------------------------------------------------------
MINDBRIDGE_CACHE_ENABLED=true
MINDBRIDGE_CACHE_TTL_SECONDS=300
